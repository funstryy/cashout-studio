# Copy this file to .env and adjust the paths for your machine. Every
# variable below is optional - if unset, config.py defaults it to
# external/<repo> next to wherever the app is running from (repo root in a
# normal checkout, the folder holding the .exe in a build_dist.py package),
# so a stock setup_models.ps1 run needs no .env at all beyond FFMPEG_BIN_DIR.
# Only set one of these if you moved that piece somewhere non-default.

# Paths to the two AI model repos this app orchestrates. Default:
# <app root>/external/ACE-Step-1.5 and <app root>/external/audio.cpp.
# ACE_STEP_DIR=E:\AI\ACE\ACE-Step-1.5
# YUE2_DIR=E:\AI\YuE2-3B

# Separate venv for Demucs (stem separation). setup_models.ps1 sets this up
# automatically in external/Demucs. Default: <app root>/external/Demucs.
# htdemucs model weights auto-download on first use (needs internet access once).
# DEMUCS_DIR=E:\AI\Demucs
# Threads a separation may use. Default: a quarter of the logical CPUs
# (about half the physical cores), which keeps the active model and the UI
# responsive while stems run in the background.
# DEMUCS_THREADS=3
# torch device for a separation. CPU by default so stems never compete with
# an active model for VRAM; a CUDA machine can set "cuda".
# DEMUCS_DEVICE=cpu

# ffmpeg bin dir (used by ACE-Step's process launch and by our own
# non-WAV-upload transcoding for YuE2). setup_models.ps1 fills this in
# automatically by locating the ffmpeg winget install from setup_prereqs.ps1;
# only set it by hand if ffmpeg lives somewhere else on your machine.
FFMPEG_BIN_DIR=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-<version>-full_build\bin

# audio.cpp (YuE2's native server) is built with the Vulkan compute backend
# (-Preset windows-vulkan-release), which works on any GPU vendor and needs
# no vendor SDK on PATH at runtime - just the Vulkan loader (vulkan-1.dll)
# that ships with your GPU driver. Only change this if you rebuild
# audio.cpp with a different -Preset (see setup_models.ps1).
YUE2_BUILD_DIR=windows-vulkan-release

# Whether both engines may be up at once. They were made mutually exclusive
# when both ran on the GPU; here YuE2 is on the GPU (Vulkan) and ACE-Step is
# on the CPU, so they compete for nothing and taking turns just leaves half
# the machine idle. Set 0 where both target the same GPU.
# CONCURRENT_ENGINES=1

# Which backend ACE-Step runs its language model through. "pt" is plain
# PyTorch: portable, and the only option without flash-attn. On an NVIDIA
# machine whose ACE-Step environment has flash-attn installed, "nanovllm" is
# considerably faster.
# ACESTEP_LM_BACKEND=pt

# Compute backend and device index for audiocpp_server (cpu|cuda|hip|vulkan).
# "vulkan" matches the build above; run
#   audiocpp_server.exe --backend vulkan --list-devices
# to see the indices.
# YUE2_BACKEND=vulkan
# YUE2_DEVICE=0

# audiocpp_server hosts YuE2, SheetSage2 and MuScriptor in one process and by
# default keeps every model it loads resident. YuE2-3B q8_0 alone is ~3.5 GB
# of VRAM, so the default below keeps exactly one of them loaded - a MIDI
# transcription evicts the generation model rather than fighting it for VRAM.
# Raise it only on a card with room to spare.
# YUE2_MAX_LOADED_MODELS=1
# Release VRAM after this long with no inference (0 disables). The next
# request reloads lazily.
# YUE2_IDLE_UNLOAD_MS=300000

# Imported reference voices (one <name>.wav each, plus a "prompt_text" index).
# Handed to audiocpp_server as its --voice-dir. Default: <app root>/data/voices.
# VOICES_DIR=E:\AI\voices
# Backend for voice-conversion jobs, which run as their own audiocpp_cli
# process rather than inside audiocpp_server - so they sit outside its
# residency cap. Defaults to YUE2_BACKEND; set "cpu" if converting while an
# engine is loaded is too much for your card.
# VOICE_BACKEND=vulkan

# ACE-Step / Demucs on AMD: PyTorch has no Vulkan path, and ROCm's Windows
# wheels want Windows 11 plus a supported card - so both run on CPU torch
# here (2.7.1, the version ACE-Step targets on Windows). torch-directml was
# tried and dropped: ACE-Step has no DirectML device-selection path, so it
# never ran anything on the GPU, and directml's torch 2.4.1 pin left
# ACE-Step's unpinned `diffusers` too new for it - which crashed the VAE
# import on the first generation.
